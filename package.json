{
  "name": "project_demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:watch:dev": "cross-env NODE_ENV=development vitest --reporter=verbose",
    "test:watch:debug": "cross-env DEBUG_TESTS=true vitest --reporter=verbose",
    "test:coverage": "vitest --run --coverage",
    "test:coverage:check": "npm run test:coverage && node scripts/coverage-check.js",
    "test:coverage:html": "npm run test:coverage && node scripts/coverage-check.js --format=html",
    "test:coverage:ci": "npm run test:coverage && node scripts/coverage-check.js --ci",
    "test:ui": "vitest --ui",
    "test:dev": "cross-env NODE_ENV=development vitest --run --reporter=verbose",
    "test:debug": "cross-env DEBUG_TESTS=true vitest --run --reporter=verbose",
    "test:failed": "vitest --run --reporter=verbose --changed",
    "test:perf": "vitest --run --reporter=verbose --logHeapUsage",
    "test:perf:analyze": "node scripts/test-performance.js",
    "test:perf:trend": "node scripts/test-performance.js --trend",
    "lint": "eslint src tests --ext .js,.vue",
    "lint:report": "mkdir -p reports && eslint src tests --ext .js,.vue --format json --output-file reports/eslint-report.json || true",
    "lint:html": "mkdir -p reports && eslint src tests --ext .js,.vue --format html --output-file reports/eslint-report.html || true",
    "metrics": "node scripts/code-metrics.js",
    "report:all": "npm run lint:report && npm run test:coverage:html && npm run metrics"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "bootstrap-vue-next": "^0.40.6",
    "browser-image-compression": "^2.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.17.21",
    "pinia": "^3.0.3",
    "sass": "^1.93.2",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.0.15",
    "@vue/test-utils": "^2.4.6",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-formatter-html": "^2.7.3",
    "eslint-plugin-vue": "^9.33.0",
    "fast-check": "^4.4.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.3.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.15"
  }
}
